# Production environment for compose.prod.yaml.
# Copy to .env.production on the server and fill in real values.
# .env.production is gitignored and must never be committed.

# --- Domains (served over HTTPS by Caddy via Let's Encrypt) ---
APP_DOMAIN=otagai.hemal.me
S3_DOMAIN=s3.hemal.me
# Contact address Let's Encrypt uses for certificate-expiry notices.
ACME_EMAIL=you@example.com

# --- Database: Supabase (not a local Postgres container) ---
# Transaction pooler (PgBouncer) for the app, session pooler for migrations.
DATABASE_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DATABASE_PORT=6543
MIGRATION_DATABASE_HOST=aws-1-ap-northeast-1.pooler.supabase.com
MIGRATION_DATABASE_PORT=5432
POSTGRES_USER=postgres.your-project-ref
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=app/database/certs/supabase-prod-ca-2021.crt
SUPABASE_URL=https://your-project-ref.supabase.co

# --- Redis (local container) ---
REDIS_PASSWORD=

# --- Object storage: rustfs (local container, S3-compatible) ---
# S3_PUBLIC_ENDPOINT_URL is the HTTPS host used only to sign media URLs
# handed to clients; the backend talks to the container over s3:9000 internally.
S3_PUBLIC_ENDPOINT_URL=https://s3.hemal.me
S3_BUCKET=otagai-media
S3_ACCESS_KEY=otagai
S3_SECRET_KEY=

# --- CORS (only needed for browser clients) ---
CORS_ALLOWED_ORIGINS=["https://otagai.hemal.me"]
CORS_ALLOW_CREDENTIALS=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Expo push (optional) ---
EXPO_ACCESS_TOKEN=

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
